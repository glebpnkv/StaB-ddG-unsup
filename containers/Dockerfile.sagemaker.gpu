# GPU training image for SageMaker (IntAct multi-GPU pretrain).
# Built on the AWS PyTorch training Deep Learning Container, which provides CUDA torch + the
# sagemaker-training toolkit (managed torchrun). torch is an optional extra in pyproject.toml, so
# `pip install -e .` only layers on the project's other dependencies, leaving the DLC's torch intact.
ARG BASE_IMAGE=763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.3.0-gpu-py311
FROM ${BASE_IMAGE}

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1

COPY pyproject.toml ./
COPY . .
# Install the project plus its `aws` extra (sagemaker SDK + boto3) so the training script can attach to
# SageMaker Experiments via load_run() — the DLC ships only the training toolkit, not the full SDK.
# tensorboard is a core dependency (the SummaryWriter needs it to emit event files), so `-e .` already
# covers it. torch stays the DLC's build (it lives under the pytorch_* extras, not core/aws). The
# MLflow sink in training.py stays dormant unless MLFLOW_TRACKING_URI is set, so mlflow is not installed.
RUN pip install -e ".[aws]"
